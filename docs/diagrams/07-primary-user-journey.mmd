flowchart TD
  Open[Open Investigation] --> Product[Select Product]
  Product --> P360[Review Product 360]
  P360 --> Timeline[Lifecycle Timeline]
  Timeline --> Evidence[Relevant Evidence]
  Evidence --> Graph[Reality Graph]
  Graph --> Patterns[AI Investigator Patterns]
  Patterns --> Hypotheses[Competing Hypotheses]
  Hypotheses --> Challenge[AI Challenger]
  Challenge --> Unknowns[Unknowns Radar]
  Unknowns --> Failure[Failure Chain]
  Failure --> Counterfactual[Constrained Scenario]
  Counterfactual --> Brief[Reality Investigation Brief]
  Brief --> Review[Authorized Human Review]
  Review --> Decision[Human Decision + Audit]
