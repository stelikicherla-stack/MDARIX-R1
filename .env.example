POSTGRES_DB=mdarix_r1
POSTGRES_USER=mdarix_app
POSTGRES_PASSWORD=CHANGE_ME
# Database hardening is opt-in and must be applied before switching runtime credentials.
MDARIX_DB_HARDENING_APPLY=0
MDARIX_DB_POOL_SIZE=5
MDARIX_DB_MAX_OVERFLOW=10
MDARIX_DB_POOL_TIMEOUT_SECONDS=30

# GenAI provider: groq (API key required) or ollama (local, no key required)
MDARIX_GENAI_PROVIDER=controlled
MDARIX_GENAI_MODEL=mdarix-controlled
MDARIX_GENAI_API_KEY=
MDARIX_GENAI_BASE_URL=
MDARIX_GENAI_TIMEOUT_SECONDS=20
MDARIX_GENAI_MAX_RETRIES=2
